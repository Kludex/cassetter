{
  "name": "cassetter",
  "version": "0.0.0",
  "description": "HTTP cassette recorder for Node.js tests. Safe by default. Rust-powered.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native/index.js",
    "native/package.json",
    "native/*.node"
  ],
  "napi": {
    "binaryName": "cassetter",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path ../crates/cassetter-node/Cargo.toml --package-json-path package.json --output-dir native",
    "build:native:debug": "napi build --platform --manifest-path ../crates/cassetter-node/Cargo.toml --package-json-path package.json --output-dir native",
    "build": "npm run build:native && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vcr",
    "cassette",
    "http",
    "test",
    "record",
    "replay",
    "mock",
    "fetch"
  ],
  "license": "MIT",
  "homepage": "https://kludex.github.io/cassetter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kludex/cassetter.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/Kludex/cassetter/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
